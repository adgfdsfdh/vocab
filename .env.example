# Скопируйте в .env.local и заполните (инструкция: docs/SUPABASE.md). .env.local не попадает в git.
# Публичные значения для браузера (защищены RLS в Supabase). secret/service_role сюда НЕ вставлять.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Только для бэкапа на ПК (scripts/backup.mjs, инструкция: docs/BACKUP.md). Без префикса VITE_ —
# поэтому в сайт и приложение этот ключ не попадает никогда.
SUPABASE_SECRET_KEY=
BACKUP_DIR=
