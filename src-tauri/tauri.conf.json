{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vocab",
  "version": "0.1.0",
  "identifier": "io.github.adgfdsfdh.vocab",
  "build": {
    "frontendDist": "https://adgfdsfdh.github.io/vocab/?compact=1"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "shortDescription": "Словарь — английские слова",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "wix": { "language": "ru-RU" }
    }
  }
}
